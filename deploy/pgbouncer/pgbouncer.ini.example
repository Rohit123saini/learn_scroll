; P-C3 -- pgbouncer for LearnScroll (transaction pooling). Copy to /etc/pgbouncer/pgbouncer.ini and edit the CAPS.
; Read deploy/PGBOUNCER.md first. Not run by the author.
[databases]
learnscroll = host=PG_HOST port=5432 dbname=learnscroll

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6432
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
admin_users = pgbouncer_admin
stats_users = pgbouncer_stats

pool_mode = transaction
; clients (web threads + celery processes + beat + one-off commands) that may connect to pgbouncer
max_client_conn = 400
; real Postgres connections per (database,user). Keep (this x number of pgbouncers) well under Postgres max_connections.
default_pool_size = 20
min_pool_size = 5
reserve_pool_size = 5
reserve_pool_timeout = 3

; give up on a client that waits too long for a server connection instead of hanging the request for ever
query_wait_timeout = 30
server_idle_timeout = 600
server_lifetime = 3600
server_connect_timeout = 10
; a Django request that holds a transaction open this long is a bug - do not let it pin a server connection
idle_transaction_timeout = 60

; Django (psycopg2) sends these at connect time; pgbouncer must not reject them
ignore_startup_parameters = extra_float_digits,options
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
