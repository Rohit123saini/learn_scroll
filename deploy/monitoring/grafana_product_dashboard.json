    {
      "id": 24,
      "type": "bargauge",
      "title": "Copy experiment - open rate by variant (%)",
      "description": "opened / pushed per variant for the experiment picked above. Judge only when BOTH variants have a few hundred pushes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
