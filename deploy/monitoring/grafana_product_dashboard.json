        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "topk(12, sum by (key) (increase(learnscroll_product_settings_changed_total[$__range])))",
