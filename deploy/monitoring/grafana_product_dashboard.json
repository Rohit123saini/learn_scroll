      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Settings visits vs changes (per hour)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(learnscroll_product_settings_opened_total[1h]))",
          "refId": "A",
          "legendFormat": "visits"
        },
        {
          "expr": "sum(increase(learnscroll_product_settings_changed_total[1h]))",
          "refId": "B",
          "legendFormat": "changes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
