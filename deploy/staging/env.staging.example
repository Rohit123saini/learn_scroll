# Copy to deploy/staging/.env.staging and replace every CHANGE_ME. Staging ONLY: Razorpay must be rzp_test_ keys.
DEBUG=False
DJANGO_ENV=staging
IMAGE_TAG=staging
ALLOWED_HOSTS=staging-api.learnscroll.app,localhost
CSRF_TRUSTED_ORIGINS=https://staging-api.learnscroll.app
SECRET_KEY=CHANGE_ME_random_50_plus_chars
JWT_SIGNING_KEY=CHANGE_ME_different_random_32_plus_chars
SECURE_SSL_REDIRECT=true
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://learnscroll:CHANGE_ME@db:5432/learnscroll
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
HEALTHCHECK_TOKEN=CHANGE_ME
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
COIN_PURCHASE_PACKS=100,250,500
LIVEKIT_API_KEY=CHANGE_ME_key
LIVEKIT_API_SECRET=CHANGE_ME_secret_32_plus_chars
LIVEKIT_WS_URL=wss://staging-lk.learnscroll.app
LIVEKIT_HTTP_URL=http://livekit:7880
LIVEKIT_NODE_IP=CHANGE_ME_public_ip_of_vm
SENTRY_ENVIRONMENT=staging
