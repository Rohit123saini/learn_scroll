# --- T0.8: legal pages / account deletion --------------------------------------------------------
LEGAL_ENTITY_NAME=Your Company Pvt Ltd
SUPPORT_EMAIL=support@example.com             # shown on /legal/delete-account/ — REQUIRED for Play
# GRIEVANCE_OFFICER_NAME / _EMAIL: set below (shared with the copyright module); the privacy policy page shows them.
LEGAL_PAGES_DRAFT_BANNER=true                 # set false ONLY after legal review of /legal/privacy/ and /legal/terms/

# --- T0.4: Razorpay (coin top-ups) ---------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks: URL https://<API_HOST>/profile/buy-coin/webhook/razorpay/
# events: payment.captured, order.paid   (auto-capture must be ON)
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
COIN_PURCHASE_PACKS=100,250,500,1000,2500      # for the Rs 1 live test temporarily use: 1,100,250,500,1000,2500
COIN_PURCHASE_INR_PER_COIN=1

# --- T0.1: host / TLS hardening (REQUIRED in production) ---------------------------------------
# Boot fails if ALLOWED_HOSTS is empty or contains '*' while DEBUG=False.
# Comma-separated, no scheme, no wildcard. A request with any other Host -> HTTP 400.
ALLOWED_HOSTS=api.learnscroll.app
CSRF_TRUSTED_ORIGINS=https://api.learnscroll.app
# Must be >= 50 chars, random, not starting with 'django-insecure' (check --deploy W009).
SECRET_KEY=PUT_A_RANDOM_50_PLUS_CHAR_VALUE_HERE  # generate: django.core.management.utils.get_random_secret_key()
# https redirect (default true when DEBUG=False). Proxy must send X-Forwarded-Proto.
SECURE_SSL_REDIRECT=true

# --- values the copyright / moderator-security work (tasks 11-14) depends on -----------------------
DEBUG=False
# P-C1: REQUIRED. With DEBUG=False and no DATABASE_URL (or a non-postgres one) the app REFUSES TO BOOT - it no longer falls back to SQLite.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/learnscroll      # PostgreSQL in production
REDIS_URL=redis://HOST:6379/0
CELERY_BROKER_URL=redis://HOST:6379/0
CELERY_RESULT_BACKEND=redis://HOST:6379/0
# Video playback pipeline (needs `ffmpeg` + `ffprobe` on the Celery worker host: sudo apt install ffmpeg).
# Converts phone H.265/HEVC uploads to H.264/AAC + faststart so every phone can play them.
# VIDEO_TRANSCODE_ENABLED=True
# VIDEO_TRANSCODE_MAX_SIDE=1280
# VIDEO_TRANSCODE_KEEP_ORIGINAL=False

# Alerts: Celery task failures, missed beat runs (Sentry Crons) and log errors all go here.
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# API docs (P-B1): /swagger/, /redoc/, /api/schema/ are STAFF-ONLY by default (log in at /admin/, then open /swagger/).
# Never set true in production - release_check and check_security_settings --production fail on it.
API_DOCS_PUBLIC=false

# WebSocket auth (P-B2): sockets use ONLY the one-time ?ticket= (POST /login/auth/ws-ticket/). Keep false / unset.
# true re-opens the old ?token=<JWT> URL login and release_check FAILS on it.
WS_ALLOW_QUERY_TOKEN=false

# Moderator / admin security
ADMIN_REQUIRE_2FA=true
STAFF_PASSWORD_MIN_LENGTH=14
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
# P-B6: private admin path (no leading slash needed) + Content-Security-Policy modes (enforce | report-only | off).
# Admin starts as report-only; open /<ADMIN_URL> once on staging, check the browser console, then set enforce.
ADMIN_URL=PUT_A_PRIVATE_PATH_HERE/
CSP_PUBLIC_MODE=enforce
CSP_ADMIN_MODE=report-only
CSP_REPORT_URI=
# P-B8: optional admin IP allow-list. Empty = off. Comma separated IPs / CIDRs, e.g. 203.0.113.7,198.51.100.0/24
# Turn it on only after `python manage.py admin_ip_check <your-office-ip>` says ALLOWED with the SAME env on staging.
ADMIN_IP_ALLOWLIST=
# Trusted reverse proxies in front of Django (nginx only = 1; CDN + nginx = 2). Needed for the allow-list AND for per-IP
# throttles / the admin lockout to see the real visitor. Leave unset only if Django is reached directly.
ADMIN_NUM_PROXIES=1

# Signup abuse (L1 gap 18) -- disposable e-mail / virtual phone block + captcha
DISPOSABLE_BLOCK_ENABLED=true
# extra throw-away domains (comma separated) and/or a file with one domain per line:
DISPOSABLE_EMAIL_EXTRA_DOMAINS=
DISPOSABLE_EMAIL_LIST_FILE=
# a real provider that was wrongly blocked (never blocked even if listed):
DISPOSABLE_EMAIL_ALLOWED_DOMAINS=
# digit prefixes of virtual number ranges to refuse, e.g. 1500,44700
BLOCKED_PHONE_PREFIXES=
# optional carrier lookup that refuses VoIP numbers: twilio (needs the two keys below)
PHONE_LOOKUP_PROVIDER=
PHONE_BLOCKED_LINE_TYPES=nonFixedVoip,voip
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# captcha: off | adaptive (ask only on bot-like traffic) | always
CAPTCHA_MODE=adaptive
# builtin needs no keys (image captcha the app shows natively); turnstile|hcaptcha|recaptcha need both keys
CAPTCHA_PROVIDER=builtin
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# login / OTP / reset audit log (admin > Auth audit logs): keep this many days, 0 = forever
AUTH_AUDIT_ENABLED=true
AUTH_AUDIT_RETENTION_DAYS=180
AUTH_AUDIT_NOISE_DEDUPE_SECONDS=60

# Legal contacts (copyrights.W001 / W002 system checks)
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
LEGAL_ORDERS_EMAIL=

# JWT signing key — MUST differ from SECRET_KEY, >= 32 chars (T1.12 / R11)
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# App update / maintenance defaults for GET /core/app-config/ (T1.8).
# A core.AppConfig row in Django admin overrides these per platform without a redeploy.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.learnscroll.app
APP_STORE_URL=
APP_MIN_SUPPORTED_VERSION=
APP_LATEST_VERSION=
APP_MAINTENANCE_MODE=False

# --- T3.7 backups / restore drill / monitoring (see deploy/BACKUP_RESTORE_RUNBOOK.md) ---------------
BACKUP_DIR=/var/backups/learnscroll
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_WEEKS=8
# Off-site copy (rclone remote). WITHOUT this the only backup lives on the same server as the DB.
BACKUP_REMOTE=s3backup:learnscroll-backups
# Optional: encrypt dumps before upload (gpg public key must be in the learnscroll user's keyring)
BACKUP_GPG_RECIPIENT=
# Role allowed to CREATE/DROP DATABASE for the weekly restore drill (defaults to DATABASE_URL)
DRILL_ADMIN_DATABASE_URL=
LEARNSCROLL_MEDIA_ROOT=/srv/learnscroll/backend/media
# PC2: scratch DB used by the weekly restore drill. Must contain "restore_drill" and must NOT be the live DB (the script refuses otherwise).
DRILL_DB=learnscroll_restore_drill
# PC2: the drill fails if the newest dump is older than this (= the nightly backup is late)
DRILL_MAX_DUMP_AGE_HOURS=36
# PC2: Prometheus metrics for backup alerts (node_exporter textfile collector dir, writable by the learnscroll user). Empty = off.
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
# Enables GET /healthz/deep/ (Celery + backups + disk). Leave empty to keep it disabled (404).
HEALTHCHECK_TOKEN=

# Campus fees online (UPI / card) — uses the Razorpay keys above
CAMPUS_FEE_ONLINE_ENABLED=1
CAMPUS_FEE_ONLINE_METHODS=upi,card

# --- C4: LiveKit (calls / study rooms / live classes) — see deploy/livekit/README.md -----------------
# Same key/secret as deploy/livekit/livekit.yaml `keys:`
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Join URL handed to the app. MUST be wss://<public domain> in production (boot fails for ws:// / localhost / private IP).
LIVEKIT_WS_URL=wss://lk.example.com
# Server-to-server API (egress, delete_room). Optional — defaults to LIVEKIT_WS_URL with wss->https. Internal URL is fine here.
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# Call recording output (message calls). Public/CDN base used to build recording_url after egress_ended.
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_PUBLIC_BASE_URL=
# tuitionclass recording (S3 creds passed per request)
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_ENDPOINT=
# Call lifecycle (C1) — optional overrides
# CALL_RING_TIMEOUT_SECONDS=45
# CALL_STALE_ONGOING_SECONDS=10800
# Group call scale (C11) — optional overrides
# CALL_GROUP_RING_CAP=10              # group call me pehle itne members ko ring; baaki ko chat me "Join" banner
# CALL_GROUP_MAX_PARTICIPANTS=50      # LiveKit room cap + join cap (409 call_full)
# CALL_PUSH_CHUNK=100                 # ek Celery push task me max recipients
# CALL_GROUP_PUSH_ASYNC=true          # group ring push + bell rows Celery me
# CALL_ROOM_CREATE_TIMEOUT_SECONDS=3  # LiveKit CreateRoom (max_participants) ka max wait

# Missed-call push + chat bubble (C12) — optional overrides
# CALL_MISSED_PUSH_ENABLED=true        # missed-call data push (false => sirf bell row + bubble)
# CALL_MISSED_BUBBLE_ENABLED=true      # connect na hui call ka chat bubble
# CALL_MISSED_PUSH_TTL_SECONDS=86400   # offline phone ke liye push validity
# CALL_MISSED_NOTIFY_ASYNC=true        # false => sync (broker ke bina)

# --- C5: killed-state incoming calls --------------------------------------------------------------
# Ring push expiry (FCM ttl + APNs apns-expiration). Client ring timeout (30s) ke barabar.
CALL_PUSH_TTL_SECONDS=30
# iOS PushKit/VoIP push. Apple Developer > Keys me APNs-enabled .p8 key banao. Khaali chhodoge to
# iOS par call FCM-only chalegi (app killed hone par ring unreliable).
APNS_VOIP_KEY_PATH=/etc/learnscroll/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# production/TestFlight = false, Xcode debug build = true
APNS_USE_SANDBOX=false

# X1 call observability (message/call_ops.py)
CALL_SLO_CONNECT_SUCCESS_PCT=95
CALL_SLO_ALERT_WINDOW_MINUTES=15
CALL_SLO_ALERT_MIN_ATTEMPTS=20
# bearer for GET /message/calls/ops/?format=prom (empty => FEED_OPS_SCRAPE_TOKEN is used)
CALL_OPS_SCRAPE_TOKEN=

# X3 - privacy-safe product analytics + A/B experiments (consent-gated aggregate counters, no user ids)
# bearer for GET /core/analytics/product/?format=prom (empty => FEED_OPS_SCRAPE_TOKEN is used)
PRODUCT_ANALYTICS_SCRAPE_TOKEN=
PRODUCT_ANALYTICS_ENABLED=1
# 1 = count only users who switched "analytics" ON in Data & privacy (recommended, DPDP); 0 = also "never asked"
PRODUCT_ANALYTICS_REQUIRE_OPT_IN=1
# comma list of experiment keys to switch on (see core/experiments.py); EXPERIMENTS_ENABLED=0 = kill switch
EXPERIMENTS_ON=
EXPERIMENTS_ENABLED=1

# =====================================================================================================
# X1 — release config additions (check everything with:  python manage.py release_check --env-file .env.production)
# =====================================================================================================

# --- Media: S3 + CDN ---------------------------------------------------------------------------------
# One box only? leave USE_S3_STORAGE=false (uploads stay on disk, back them up!). For scale / rebuilds use S3.
USE_S3_STORAGE=true
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_STORAGE_BUCKET_NAME=learnscroll-media
AWS_S3_REGION_NAME=ap-south-1
# S3-compatible (Cloudflare R2 / DigitalOcean Spaces / MinIO) only:
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# ONE CDN switch (settings.py C5). https only, no trailing slash needed.
MEDIA_CDN_ENABLED=true
MEDIA_CDN_URL=https://cdn.learnscroll.app

# --- FCM push (Firebase Admin) -----------------------------------------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key. Keep OUTSIDE the repo; chmod 600.
# Default if unset: <backend>/firebase-service-account.json (settings.FCM_SERVICE_ACCOUNT_JSON_PATH)
FIREBASE_CREDENTIALS_PATH=/etc/learnscroll/firebase-service-account.json
# Google sign-in: the WEB client id of the same Firebase / Google Cloud project (server verifies ID tokens with it)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# T1 - optional: web + android + ios audiences, comma separated (GOOGLE_CLIENT_ID above stays as the fallback)
GOOGLE_CLIENT_IDS=
# T1 - seconds before a Google cert fetch is given up (503 google_unreachable)
GOOGLE_VERIFY_TIMEOUT=5

# --- Deep links (served by common/web_links.py) ------------------------------------------------------
# https://<API_HOST>/.well-known/assetlinks.json  and  /.well-known/apple-app-site-association
ANDROID_APP_PACKAGE=com.learnscroll.app
# SHA-256 of the key that SIGNS the installed app. With Play App Signing that is the *App signing key* shown in
# Play Console > Setup > App signing (NOT your upload key). Add the upload key too (comma) if you sideload release builds.
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
# Apple Developer > Membership > Team ID  +  bundle id
IOS_APP_ID=ABCDE12345.com.learnscroll.app

# P-G1: coin CASH-OUT kill switch. Leave OFF (or unset) until deploy/COIN_CASHOUT_REENABLE.md is signed off.
COIN_CASHOUT_ENABLED=false

# P-J2: remote kill switches. Normal way = Django admin > Core > Feature flags (no deploy, live within ~30 s).
# Emergency lever that works even with the database down (needs a restart): comma list of
#   live, reels_upload, coin_purchase, ai_features, cashout
FEATURE_FLAGS_OFF=
# Optional hard min-version gate (426 UPDATE_REQUIRED for builds older than min_supported_version). Keep false until
# deploy/FORCE_UPDATE_TEST_PLAN.md has been run on staging.
APP_HARD_MIN_VERSION_GATE=false

# P-C3 -- Sentry traces + Celery ops (all optional; defaults shown)
SENTRY_TRACES_SAMPLE_RATE=0.1
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660
CELERY_FAIL_ALERT_THRESHOLD=5
BEAT_SINGLE_INSTANCE_GUARD=true
# DB_CONN_MAX_AGE=60
# DB_DISABLE_SERVER_SIDE_CURSORS=false   # true behind pgbouncer transaction mode

# --- P-C8: read replica (optional, default OFF) + API cache default ---
# DB_REPLICA_ENABLED=false
# DB_REPLICA_URL=postgres://USER:PASSWORD@REPLICA_HOST:5432/DBNAME
# DB_REPLICA_PATH_PREFIXES=/post/feed/,/post/reels/,/profile/search/
# DB_REPLICA_PIN_SECONDS=5
# DB_REPLICA_DOWN_SECONDS=30
# API_CACHE_DEFAULT_PRIVATE=true
